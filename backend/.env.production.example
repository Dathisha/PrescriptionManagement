##############################################################
# HOSTINGER PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env on your Hostinger server and fill in the
# values. NEVER commit real passwords to source control.
##############################################################

APP_NAME="Prescription Management"
APP_ENV=production
APP_KEY=              # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com   # Replace with your actual domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────
# Use the MySQL credentials from your Hostinger control panel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ── Session & Cache ───────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public    # Must be 'public' for uploaded files to be web-accessible
QUEUE_CONNECTION=sync     # Use 'sync' on shared hosting (no queue worker)
CACHE_STORE=file          # Use 'file' on shared hosting (no Redis/Memcached)

# ── Mail (configure as needed) ───────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="Prescription Management"

# ─────────────────────────────────────────────────────────────
# After uploading, run these Artisan commands:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:clear
#   php artisan cache:clear
#   php artisan route:clear
#   php artisan view:clear
#   php artisan optimize
# ─────────────────────────────────────────────────────────────
